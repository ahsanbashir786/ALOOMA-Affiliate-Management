DATABASE_URL=postgres://user:password@localhost:5432/affiliate

# TikTok Shop connection (optional – see docs/TIKTOK-API.md). Keep the real values private.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=

# TikTok Ads / GMV Max (optional – see docs/TIKTOK-ADS-API.md). A different service from TikTok Shop, with its own app. Keep the real values private.
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_APP_SECRET=
# Only if the address TikTok sends you back to must differ from the website's own address:
# TIKTOK_ADS_REDIRECT_URI=https://your-domain/api/tiktok-ads/callback
