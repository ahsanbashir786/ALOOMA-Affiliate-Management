{
  "name": "affiliate-management-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "import:sample": "tsx --env-file=.env --conditions=react-server scripts/import-sample.ts",
    "test:workflow": "tsx --conditions=react-server scripts/test-workflow.ts",
    "test:regressions": "tsx --conditions=react-server scripts/test-regressions.ts",
    "test:real": "tsx --conditions=react-server scripts/test-real-exports.ts",
    "typecheck": "tsc --noEmit",
    "test:tiktok": "tsx --conditions=react-server scripts/test-tiktok.ts",
    "test:sync": "tsx --conditions=react-server scripts/test-sync.ts",
    "test:creators": "tsx --conditions=react-server scripts/test-creators.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
