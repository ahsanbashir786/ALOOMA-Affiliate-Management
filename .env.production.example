# Copy to ".env" on the server:  cp .env.production.example .env   then edit the two values below.
DOMAIN=affiliates.example.com
POSTGRES_PASSWORD=change-this-to-a-long-random-password
# COOKIE_SECURE=true

# TikTok Shop connection (add after the site runs on your domain with https; keep these private):
# TIKTOK_APP_KEY=
# TIKTOK_APP_SECRET=
# TIKTOK_SERVICE_ID=
# TikTok Ads / GMV Max (a different app from TikTok Shop):
# TIKTOK_ADS_APP_ID=
# TIKTOK_ADS_APP_SECRET=
